{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant4dad.local/contracts/bridge-v1/model-probe-result.schema.json",
  "type": "object",
  "required": [
    "provider",
    "model",
    "model_config_revision",
    "probe_version",
    "status",
    "reason",
    "context_source",
    "checked_at_ms",
    "expires_at_ms",
    "context_window",
    "max_output_tokens",
    "model_turns",
    "tool_calls",
    "first_event_ms"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}(?![\\s\\S])"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./:-]{1,128}(?![\\s\\S])"
    },
    "model_config_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
    },
    "probe_version": {
      "const": "echo-v1"
    },
    "status": {
      "enum": [
        "ready",
        "incompatible",
        "unavailable"
      ]
    },
    "reason": {
      "enum": [
        "probe_passed",
        "probe_contract_mismatch",
        "probe_request_failed"
      ]
    },
    "context_source": {
      "const": "explicit-config"
    },
    "checked_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "context_window": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100000000
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "model_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "first_event_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15000
    }
  },
  "additionalProperties": false
}
