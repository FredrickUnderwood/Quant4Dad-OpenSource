{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant4dad.local/contracts/bridge-v1/capabilities.schema.json",
  "title": "Q4D Agent Bridge v1 capabilities",
  "type": "object",
  "required": [
    "bridge_protocol",
    "adapter_version",
    "backend",
    "dsh_version",
    "session_format",
    "event_journal_format",
    "features",
    "model_config_revision"
  ],
  "properties": {
    "bridge_protocol": {
      "const": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": [
        "acp",
        "cordis"
      ]
    },
    "dsh_version": {
      "type": "string",
      "minLength": 1
    },
    "session_format": {
      "type": "integer",
      "minimum": 0
    },
    "event_journal_format": {
      "type": "integer",
      "minimum": 1
    },
    "features": {
      "type": "object",
      "required": [
        "session_resume",
        "event_replay",
        "cancel",
        "approval",
        "raw_provider_delta",
        "compaction_events",
        "fork"
      ],
      "properties": {
        "session_resume": {
          "type": "boolean"
        },
        "event_replay": {
          "type": "boolean"
        },
        "cancel": {
          "type": "boolean"
        },
        "approval": {
          "type": "boolean"
        },
        "raw_provider_delta": {
          "type": "boolean"
        },
        "compaction_events": {
          "type": "boolean"
        },
        "fork": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "model_config_revision": {
      "type": "string",
      "minLength": 1
    },
    "profile_source": {
      "enum": [
        "repository",
        "config"
      ]
    },
    "profiles_aligned": {
      "type": "boolean"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "promptBundleDigest",
          "skillsDigest",
          "toolCatalogRevision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}(?![\\s\\S])"
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "promptBundleDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "skillsDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
          },
          "toolCatalogRevision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
              },
              {
                "const": ""
              }
            ]
          }
        }
      }
    }
  },
  "additionalProperties": true
}
