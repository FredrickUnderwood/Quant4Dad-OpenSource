{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant4dad.local/contracts/bridge-v1/prompt-request.schema.json",
  "title": "Q4D Agent Bridge v1 prompt request",
  "type": "object",
  "required": [
    "q4d_session_id",
    "run_id",
    "client_request_id",
    "request_hash",
    "run_capability",
    "execution_envelope_digest",
    "content"
  ],
  "properties": {
    "q4d_session_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "client_request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "request_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "run_capability": { "type": "string", "pattern": "^[!-~]{1,8192}$" },
    "execution_envelope_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": { "const": "text" },
          "text": { "type": "string", "minLength": 1, "maxLength": 32000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
