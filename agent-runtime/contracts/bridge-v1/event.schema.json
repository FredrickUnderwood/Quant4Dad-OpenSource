{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant4dad.local/contracts/bridge-v1/event.schema.json",
  "title": "Q4D Agent Bridge v1 canonical event",
  "type": "object",
  "required": [
    "id",
    "run_id",
    "session_id",
    "type",
    "occurred_at",
    "schema_version",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "run.started",
        "run.progress",
        "message.delta",
        "message.completed",
        "tool.proposed",
        "approval.required",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "usage.updated",
        "context.compacted",
        "run.completed",
        "run.failed",
        "run.interrupted",
        "run.cancelled",
        "heartbeat"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": 1
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "oneOf": [
    {
      "$ref": "tool-event.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "run.started"
        },
        "data": {
          "type": "object",
          "required": [
            "message_id",
            "execution_envelope_digest"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "execution_envelope_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.delta"
        },
        "data": {
          "type": "object",
          "required": [
            "message_id",
            "text"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "message.completed"
        },
        "data": {
          "type": "object",
          "required": [
            "message_id",
            "text"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "usage.updated"
        },
        "data": {
          "type": "object",
          "required": [
            "message_id",
            "usage"
          ],
          "properties": {
            "message_id": {
              "type": "string",
              "minLength": 1
            },
            "usage": {
              "type": "object",
              "required": [
                "input_tokens",
                "output_tokens"
              ],
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "total_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cache_read_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cache_write_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reasoning_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "context.compacted"
        },
        "data": {
          "type": "object",
          "required": [
            "source_seq"
          ],
          "properties": {
            "source_seq": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.completed"
        },
        "data": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.failed"
        },
        "data": {
          "type": "object",
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "enum": [
                "agent_model_error",
                "agent_model_limit",
                "agent_run_blocked",
                "agent_run_failed"
              ]
            },
            "retryable": {
              "const": false
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "used",
                "limit",
                "requested"
              ],
              "properties": {
                "dimension": {
                  "enum": [
                    "output_per_call",
                    "model_calls",
                    "tool_calls",
                    "input_tokens",
                    "output_tokens",
                    "context_window"
                  ]
                },
                "used": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "requested": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.interrupted"
        },
        "data": {
          "type": "object",
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "const": "agent_runtime_interrupted"
            },
            "retryable": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.cancelled"
        },
        "data": {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "const": "user"
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "heartbeat"
        },
        "data": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "run.progress"
        },
        "data": {
          "type": "object",
          "required": [
            "stage"
          ],
          "properties": {
            "stage": {
              "enum": [
                "compacting",
                "compaction_failed",
                "context_recovery",
                "output_recovery",
                "finalizing"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
